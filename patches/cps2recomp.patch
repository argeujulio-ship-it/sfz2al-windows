+            Color(r,0,0,0,0);Rect(r,s.x,s.y,s.w,s.h);
+            SDL_SetRenderDrawBlendMode(r,SDL_BLENDMODE_BLEND);
+            if(theme==Theme::Crt) {
+                // Stable scanlines; no flicker or animated noise.
+                Color(r,0,0,0,43);
+                int step=std::max(2,int(s.h/224.f));
+                for(int y=int(s.y)+1;y<int(s.y+s.h);y+=step)Rect(r,s.x,float(y),s.w,1);

+public:
+    ~ThemeOverlay(){Close();}
+    void Close(){if(texture)SDL_DestroyTexture(texture);texture=nullptr;width=height=0;}
+    void Draw(SDL_Renderer *r,Theme theme,int w,int h,const SDL_FRect &s) {

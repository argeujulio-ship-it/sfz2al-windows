@@ -451,11 +451,19 @@ void M68K::Execute(uint16_t op) {
         if ((op & 0xFF80) == 0x4E80) { // JSR, JMP
             static constexpr uint8_t kJump[12] = {0, 0, 8, 0, 0, 10, 14, 10, 12, 10, 14, 0};
             const Operand target = Locate(mode, reg, 2);
+            // JMP/JSR (An) still refetch when An names the sequential PC.
+            // RefillWait detects other destinations by a changed PC, so it
+            // cannot see this case. MC68000UM table 8-10 lists two reads.
+            const bool sequentialRefetch = fetchedWords == 1 && target.at == pc;
             if (!(op & 0x0040)) {
                 Push32(pc);
                 m_cycles += 8;
             }
             pc = target.at;
+            if (sequentialRefetch) {
+                cycles += busWait;
+                waitsCounted += busWait;
+            }
             m_cycles += kJump[modeIndex];
             m_jumped = modeIndex < 7 || modeIndex == 10; // (through a register: not a fixed place)
             return;

+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <vector>
+namespace port {
+class ColorAdjust {
+    int brightness=0,contrast=100;
+    std::array<uint8_t,256> table{};
+    std::vector<uint32_t> buffer;
+public:
+    void Set(int light,int gain) {
+        light=std::clamp(light,-50,50);gain=std::clamp(gain,50,150);
+        if(light==brightness&&gain==contrast)return;
+        brightness=light;contrast=gain;
+        for(int c=0;c<256;++c)table[c]=uint8_t(std::clamp(std::lround((c-128)*gain/100.0+128+light*2.55),0L,255L));
+    }
+    const uint32_t *Apply(const uint32_t *pixels,size_t count) {
+        if(brightness==0&&contrast==100)return pixels;
+        buffer.resize(count);
+        for(size_t i=0;i<count;++i) {
+            auto p=pixels[i];
+            buffer[i]=(p&0xff000000u)|table[p&255]|(uint32_t(table[(p>>8)&255])<<8)|(uint32_t(table[(p>>16)&255])<<16);
+        }
+        return buffer.data();
+    }
+};
+}

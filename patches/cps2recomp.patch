diff --git a/port/themes.h b/port/themes.h
new file mode 100644
--- /dev/null
+++ b/port/themes.h
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Original procedural cabinet and television artwork; no game assets.
+#pragma once
+#include "present.h"
+#include <algorithm>
+#include <cmath>
+
+namespace port {
+enum class Theme { Clean, Arcade, Crt, Cabinet };
+inline Theme ParseTheme(const std::string &name) {
+    return name=="arcade"?Theme::Arcade:name=="crt"?Theme::Crt:name=="cabinet"?Theme::Cabinet:Theme::Clean;
+}
+inline SDL_FRect ThemePicture(Theme theme,int w,int h,int columns,int rows,Shape shape,Scaling scaling) {
+    if(theme==Theme::Clean)return FitPicture(w,h,columns,rows,shape,scaling);
+    SDL_FRect area=theme==Theme::Arcade?SDL_FRect{w*.065f,h*.16f,w*.87f,h*.64f}:SDL_FRect{w*.045f,h*.075f,w*.78f,h*.85f};
+    if(theme==Theme::Cabinet)area={w*.16f,h*.17f,w*.68f,h*.58f};
+    auto r=FitPicture(std::max(1,int(area.w)),std::max(1,int(area.h)),columns,rows,shape,scaling);
+    r.x+=area.x;r.y+=area.y;return r;
+}
+class ThemeOverlay {
+    SDL_Texture *texture=nullptr;
+    int width=0,height=0;
+    Theme cached=Theme::Clean;
+    SDL_FRect screen{};
+    static void Color(SDL_Renderer *r,int red,int green,int blue,int alpha=255) {
+        SDL_SetRenderDrawColor(r,Uint8(red),Uint8(green),Uint8(blue),Uint8(alpha));
+    }
+    static void Rect(SDL_Renderer *r,float x,float y,float w,float h) {
+        SDL_FRect box{x,y,w,h};SDL_RenderFillRect(r,&box);
+    }
